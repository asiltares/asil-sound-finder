{
  "manifest_version": 3,
  "name": "asil-sound-finder",
  "version": "1.0.0",
  "description": "Identify the song playing in any browser tab with no microphone and no API key. Made by asiltares: github.com/asiltares",
  "homepage_url": "https://github.com/asiltares/asil-sound-finder",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequest",
    "contextMenus"
  ],
  "host_permissions": [
    "https://amp.shazam.com/*",
    "https://api.audd.io/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup/*",
        "lib/*.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "asil-sound-finder",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shazam_headers",
        "enabled": true,
        "path": "background/rules.json"
      }
    ]
  }
}
